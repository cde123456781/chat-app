@page "/groupmessages"
@using Microsoft.EntityFrameworkCore

@using chat_app.Models
@using chat_app.Data
@implements IAsyncDisposable
@inject IDbContextFactory<chat_app.Data.chat_appContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="groupmessages/create">Create New</a>
</p>


<MudDataGrid Items="context.GroupMessage">
    <Columns>
        <PropertyColumn Property="groupmessage => groupmessage.Message" />
        <TemplateColumn>
            <CellTemplate>
                <a href="@($"groupmessages/edit?id={context.Item.Id}")">Edit</a> |
                <a href="@($"groupmessages/details?id={context.Item.Id}")">Details</a> |
                <a href="@($"groupmessages/delete?id={context.Item.Id}")">Delete</a>

            </CellTemplate>
        </TemplateColumn>
    </Columns>



</MudDataGrid>

@code {
    private chat_appContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
