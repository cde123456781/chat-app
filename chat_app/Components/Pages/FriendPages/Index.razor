@page "/friends"
@using Microsoft.EntityFrameworkCore

@using chat_app.Models
@using chat_app.Data
@implements IAsyncDisposable
@inject IDbContextFactory<chat_app.Data.chat_appContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="friends/create">Create New</a>
</p>


<MudDataGrid Items="context.Friend">
    <Columns>
        <PropertyColumn Property="friend => friend.Accepted" />
        <TemplateColumn>
            <CellTemplate>
                <a href="@($"friends/edit?id={context.Item.User1Id}")">Edit</a> |
                <a href="@($"friends/details?id={context.Item.User1Id}")">Details</a> |
                <a href="@($"friends/delete?id={context.Item.User1Id}")">Delete</a>

            </CellTemplate>
        </TemplateColumn>
    </Columns>



</MudDataGrid>

@code {
    private chat_appContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
