@page "/"
@using chat_app.Components.Pages.HomePages.HelperClasses;


@if (state.IsHome())
{
	<LandingPage @bind-HomeStateValue=state/>
} else if (state.IsLogin())
{
	<Login @bind-HomeStateValue=state/>
} else if (state.IsRegister())
{
	<Register @bind-HomeStateValue=state/>
}


@code {
	HomeState state = new HomeState();

    


}