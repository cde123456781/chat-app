@page "/groups"
@using Microsoft.EntityFrameworkCore
@using chat_app.Models
@using chat_app.Data
@implements IAsyncDisposable
@inject IDbContextFactory<chat_app.Data.chat_appContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="groups/create">Create New</a>
</p>


<MudDataGrid Items="context.Group">
    <Columns>
        <PropertyColumn Property="group => group.Name" />
        <PropertyColumn Property="group => group.Description" />
        <PropertyColumn Property="group => group.OwnerId" />
        <TemplateColumn>
            <CellTemplate>
                <a href="@($"groups/edit?id={context.Item.Id}")">Edit</a> |
                <a href="@($"groups/details?id={context.Item.Id}")">Details</a> |
                <a href="@($"groups/delete?id={context.Item.Id}")">Delete</a>

            </CellTemplate>
        </TemplateColumn>
    </Columns>



</MudDataGrid>

@code {
    private chat_appContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
